{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BankingTradeReportingSchema",
  "description": "Standardized canonical trade reporting schema for OTC and exchange-traded derivatives under MiFID II, EMIR, and Dodd-Frank.",
  "type": "object",
  "required": [
    "Trade_ID",
    "Asset_Class",
    "Timestamp",
    "Counterparty_LEI",
    "Price",
    "Quantity",
    "Currency"
  ],
  "properties": {
    "Trade_ID": {
      "type": "string",
      "description": "Unique trade transaction reference number"
    },
    "Asset_Class": {
      "type": "string",
      "enum": ["EQUITY", "FX", "COMMODITY", "RATES", "CREDIT"],
      "description": "Broad financial instrument category"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "System ingestion timestamp"
    },
    "Execution_Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp of execution down to milliseconds"
    },
    "Counterparty_LEI": {
      "type": "string",
      "pattern": "^[A-Z0-9]{4}[0-9]{2}[A-Z0-9]{12}[0-9]{2}$",
      "description": "ISO 17442 Legal Entity Identifier of the counterparty"
    },
    "Price": {
      "type": "number",
      "minimum": 0.0001,
      "description": "Unit price of the transaction"
    },
    "Quantity": {
      "type": "number",
      "minimum": 0.0001,
      "description": "Number of units or notional quantity"
    },
    "Currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 three-letter currency code"
    },
    "Venue": {
      "type": "string",
      "pattern": "^[A-Z0-9]{4}$",
      "description": "ISO 10383 Market Identifier Code (MIC) or XOFF for OTC"
    },
    "Trader_ID": {
      "type": "string",
      "description": "Identifier of the individual trader or execution algorithm"
    },
    "Maturity_Date": {
      "type": "string",
      "format": "date",
      "description": "Contract maturity or termination date"
    },
    "UTI": {
      "type": "string",
      "description": "Unique Trade Identifier for trade repository reporting"
    },
    "UPI": {
      "type": "string",
      "description": "Unique Product Identifier"
    }
  }
}
